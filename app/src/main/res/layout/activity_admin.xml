<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#1A2B4A"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GP"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRUPO PALMAS"
                    android:textColor="#1A2B4A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panel de Administración"
                    android:textColor="#6B7280"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- AUTENTICACIÓN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTENTICACIÓN"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="12dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contraseña de administrador"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="#1A2B4A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnAcceder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#1A2B4A"
                    android:text="Ingresar"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GESTIÓN DE INSTALACIÓN -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInstalacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.4"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GESTIÓN DE INSTALACIÓN"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvEstadoInstalacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: Bloqueada"
                    android:textSize="13sp"
                    android:textColor="#DC2626"
                    android:paddingBottom="12dp"/>

                <Button
                    android:id="@+id/btnPermitirApp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1A2B4A"
                    android:text="Permitir instalación temporalmente"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnBloquearApp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#DC2626"
                    android:text="Bloquear instalación"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GESTIÓN DE APPS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.4"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GESTIÓN DE APPS"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Control de Play Store (requiere Device Owner)"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:paddingBottom="12dp"/>

                <Button
                    android:id="@+id/btnOcultarPlayStore"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1A2B4A"
                    android:text="Ocultar Play Store"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnMostrarPlayStore"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#374151"
                    android:text="Mostrar Play Store"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- COMANDOS REMOTOS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardComandos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.4"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMANDOS REMOTOS"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="12dp"/>

                <Button
                    android:id="@+id/btnLockDevice"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1A2B4A"
                    android:text="Bloquear pantalla ahora"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnWipeDevice"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#DC2626"
                    android:text="Borrado total (Factory Reset)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnRemoveDeviceOwner"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#374151"
                    android:text="Quitar Device Owner"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SEGURIDAD Y CONFIGURACIÓN -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSeguridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.4"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTRASEÑA DE ADMINISTRADOR"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="12dp"/>

                <EditText
                    android:id="@+id/etNuevaPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nueva contraseña"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="#1A2B4A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="10dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnCambiarPassword"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1A2B4A"
                    android:text="Cambiar contraseña"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp"
                    android:enabled="false"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEDE DEL DISPOSITIVO"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="10dp"/>

                <Spinner
                    android:id="@+id/spinnerSede"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="16dp"
                    android:enabled="false"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATOS DEL COLABORADOR"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="10dp"/>

                <EditText
                    android:id="@+id/etNombreColaborador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre completo"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textColor="#1A2B4A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <EditText
                    android:id="@+id/etDNI"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="DNI (8 dígitos)"
                    android:inputType="number"
                    android:maxLength="8"
                    android:padding="12dp"
                    android:textColor="#1A2B4A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <EditText
                    android:id="@+id/etArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Área"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#1A2B4A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <EditText
                    android:id="@+id/etPuesto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Puesto"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#1A2B4A"
                    android:textColorHint="#9CA3AF"
                    android:background="#F9FAFB"
                    android:layout_marginBottom="12dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnGuardarSede"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1A2B4A"
                    android:text="Guardar datos del dispositivo"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- REGISTRO DE ACTIVIDAD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:alpha="0.4"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTRO DE ACTIVIDAD"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:paddingBottom="10dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="12dp"
                    android:background="#F9FAFB"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin actividad registrada"
                        android:textSize="11sp"
                        android:textColor="#374151"
                        android:fontFamily="monospace"/>
                </ScrollView>

                <Button
                    android:id="@+id/btnRefrescarLog"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1A2B4A"
                    android:text="Actualizar registro"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnLimpiarLog"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#6B7280"
                    android:text="Limpiar registro"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grupo Palmas MDM — Uso exclusivo TI"
            android:textSize="11sp"
            android:textColor="#9CA3AF"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
