# PostgreSQL (usado por Docker Compose)
DB_PASSWORD=elige_una_password_segura

# MQTT (Mosquitto en el servidor host)
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USER=mdm-server
MQTT_PASS=TU_PASSWORD_MQTT

# JWT
SECRET_KEY=cambia-esto-por-una-clave-segura-larga

# Password del usuario admin inicial
ADMIN_PASSWORD=GrupopalmasTI2024

# InvGate API (OAuth2 client credentials)
INVGATE_URL=https://grupopalmas.is.cloud.invgate.net
INVGATE_CLIENT_ID=
INVGATE_CLIENT_SECRET=

# Enrolamiento (QR de provisioning Android Enterprise)
# IP del servidor MDM corporativo (el dispositivo ya enrolado reporta aquí).
MDM_SERVIDOR_IP=10.181.8.8
# URL HTTPS donde se descarga el APK admin durante el provisioning (Android
# exige HTTPS, por eso NO se sirve desde el servidor corporativo HTTP).
MDM_APK_URL=https://raw.githubusercontent.com/linalvaradog/app/claude/peaceful-shannon-tvel7u/releases/app-release.apk
# ComponentName del DeviceAdminReceiver: <applicationId>/<applicationId>.DeviceAdminReceiver
MDM_DEVICE_ADMIN=com.palmas.mdm/com.palmas.mdm.DeviceAdminReceiver
# SHA-256 del APK en MDM_APK_URL, en Base64 URL-safe sin padding.
# IMPORTANTE: recalcular y actualizar cada vez que se publique un nuevo APK,
# o el provisioning fallará en el dispositivo (checksum no coincide).
MDM_APK_CHECKSUM=-MW2djpyqVo7CDA0XN8hqDqhWlU8may7D8CO8ZCC3yg
